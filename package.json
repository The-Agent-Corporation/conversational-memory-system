{
  "name": "conversational-memory-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "memory": "./bin/memory"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "MEMORY_MODEL_PATH=./tests/fixtures/models vitest run tests/embeddings/transformer-embedder.golden.test.ts",
    "typecheck": "tsc --noEmit",
    "memory:codex:discover": "tsx src/imports/codex-discover-command.ts",
    "memory:codex:import": "tsx src/imports/codex-import-command.ts",
    "memory:claude:discover": "tsx src/imports/history-discover-command.ts --source claude-code",
    "memory:claude:import": "tsx src/imports/history-import-command.ts --source claude-code",
    "memory:openclaw:discover": "tsx src/imports/history-discover-command.ts --source openclaw",
    "memory:openclaw:import": "tsx src/imports/history-import-command.ts --source openclaw",
    "memory:hermes:discover": "tsx src/imports/history-discover-command.ts --source hermes",
    "memory:hermes:import": "tsx src/imports/history-import-command.ts --source hermes",
    "memory:bootstrap": "tsx src/bootstrap/bootstrap-command.ts",
    "memory:status": "tsx src/bootstrap/status-command.ts",
    "memory:daemon": "tsx src/daemon/daemon-command.ts",
    "memory:daemon:launch-agent-uat": "zsh scripts/macos-launch-agent-uat.zsh",
    "memory:daemon:notification-smoke": "tsx src/daemon/macos/notification-smoke-command.ts",
    "memory:mcp": "tsx src/mcp/server-command.ts",
    "memory:source:revoke": "tsx src/imports/source-revoke-command.ts",
    "memory:source:delete": "tsx src/imports/source-delete-command.ts",
    "memory:quarantine": "tsx src/imports/quarantine-command.ts",
    "hermes:ingest": "tsx src/integrations/hermes/ingest-command.ts",
    "hermes:inject": "tsx src/integrations/hermes/inject-command.ts",
    "hermes:proposals:approve": "tsx src/integrations/hermes/proposals-approve-command.ts",
    "hermes:proposals:list": "tsx src/integrations/hermes/proposals-list-command.ts",
    "hermes:proposals:reject": "tsx src/integrations/hermes/proposals-reject-command.ts",
    "hermes:resume": "tsx src/integrations/hermes/resume-command.ts",
    "hermes:roscoe-env": "tsx src/integrations/hermes/roscoe-env-command.ts",
    "hermes:sleep": "tsx src/integrations/hermes/sleep-command.ts",
    "hermes:smoke": "tsx src/integrations/hermes/smoke-harness.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "canonicalize": "3.0.0",
    "jose": "6.2.3",
    "libsodium-wrappers-sumo": "0.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
